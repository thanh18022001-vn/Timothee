############################################################

# gen_merge.tcl

#

# Usage:

# tclsh gen_merge.tcl input.cfg merge.tcl.template

#

############################################################

if {$argc != 2} {

```
puts "Usage:"
puts "    tclsh gen_merge.tcl input.cfg merge.tcl.template"
exit 1
```

}

set CFG_FILE      [lindex $argv 0]
set TEMPLATE_FILE [lindex $argv 1]

source $CFG_FILE

set fp [open $TEMPLATE_FILE r]
set data [read $fp]
close $fp

set data [string map [list 
**COVER_GDS**         $COVER_GDS 
**COVER_TOP_CELL**    $COVER_TOP_CELL 
**APR_GDS**           $APR_GDS 
**APR_TOP_CELL**      $APR_TOP_CELL 
**APR_FILL_GDS**      $APR_FILL_GDS 
**APR_FILL_TOP_CELL** $APR_FILL_TOP_CELL 
**MACRO_GDS_PATH**    $MACRO_GDS_PATH 
**OUTPUT_GDS**        $OUTPUT_GDS 
**TECH_FILE**         $TECH_FILE 
**LAYER_MAP**         $LAYER_MAP 
] $data]

set chipName [file rootname [file tail $APR_GDS]]

set OUTPUT_SCRIPT "${chipName}_merge.tcl"

set fp [open $OUTPUT_SCRIPT w]
puts $fp $data
close $fp

puts ""
puts "Generated:"
puts "    $OUTPUT_SCRIPT"
puts ""
