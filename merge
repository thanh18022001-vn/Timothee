############################################################

# merge.tcl

#

# Usage:

# laker -b merge.tcl input.cfg

#

# Flow:

# 1. Load merge_utils.tcl

# 2. Load input.cfg

# 3. Collect Macro GDS

# 4. Import Macro GDS

# 5. Import APR

# 6. Import APR_FILL

# 7. Import COVER

# 8. Open COVER cell

# 9. Create APR instance

# 10. Create APR_FILL instance

# 11. Save COVER cell

# 12. Export merged GDS

############################################################

############################################################

# Check Input

############################################################

if {$argc != 1} {

```
puts ""
puts "Usage:"
puts "    laker -b merge.tcl input.cfg"
puts ""
exit 1
```

}

############################################################

# Get Config File

############################################################

set CFG_FILE [file normalize [lindex $argv 0]]

if {![file exists $CFG_FILE]} {

```
puts ""
puts "ERROR: Config file not found"
puts $CFG_FILE
puts ""
exit 1
```

}

############################################################

# Load Utility Functions

############################################################

set SCRIPT_DIR [file dirname [info script]]

source [file join $SCRIPT_DIR merge_utils.tcl]

############################################################

# Load Configuration

############################################################

puts ""
puts "================================"
puts "Load Config"
puts "================================"
puts $CFG_FILE
puts ""

source $CFG_FILE

############################################################

# STEP 1

# Collect Macro GDS

############################################################

puts ""
puts "================================"
puts "Collect Macro GDS"
puts "Path : $MACRO_GDS_PATH"
puts "================================"

set MACRO_LIST [collectGDS $MACRO_GDS_PATH]

if {[llength $MACRO_LIST] == 0} {

```
puts ""
puts "ERROR: No Macro GDS Found"
puts $MACRO_GDS_PATH
puts ""
exit 1
```

}

############################################################

# STEP 2

# Import Macro Libraries

############################################################

puts ""
puts "================================"
puts "Import Macro Libraries"
puts "================================"

set MACRO_LIB_LIST {}

foreach macro $MACRO_LIST {

```
set macroLib [getLibName $macro]

lappend MACRO_LIB_LIST $macroLib

importStream \
    $macro \
    $macroLib
```

}

############################################################

# STEP 3

# Import APR

############################################################

puts ""
puts "================================"
puts "Import APR"
puts "================================"

set APR_LIB [getLibName $APR_GDS]

importStream 
$APR_GDS 
$APR_LIB 
$MACRO_LIB_LIST

############################################################

# STEP 4

# Import APR_FILL

############################################################

puts ""
puts "================================"
puts "Import APR_FILL"
puts "================================"

set APR_FILL_LIB [getLibName $APR_FILL_GDS]

importStream 
$APR_FILL_GDS 
$APR_FILL_LIB

############################################################

# STEP 5

# Import COVER

############################################################

puts ""
puts "================================"
puts "Import COVER"
puts "================================"

set COVER_LIB [getLibName $COVER_GDS]

set COVER_REFLIBS [list 
$APR_LIB 
$APR_FILL_LIB]

importStream 
$COVER_GDS 
$COVER_LIB 
$COVER_REFLIBS

############################################################

# STEP 6

# Open COVER Cell

############################################################

puts ""
puts "================================"
puts "Open COVER Cell"
puts "================================"

set COVER_CV [lakerOpenDesign 
-lib $COVER_LIB 
-cell $COVER_TOP_CELL 
-view layout 
-mode edit]

############################################################

# STEP 7

# Create APR Instance

############################################################

puts ""
puts "================================"
puts "Create APR Instance"
puts "================================"

lakerCreateInstance 
-cellView $COVER_CV 
-lib $APR_LIB 
-cell $APR_TOP_CELL 
-view layout 
-point {0 0}

############################################################

# STEP 8

# Create APR_FILL Instance

############################################################

puts ""
puts "================================"
puts "Create APR_FILL Instance"
puts "================================"

lakerCreateInstance 
-cellView $COVER_CV 
-lib $APR_FILL_LIB 
-cell $APR_FILL_TOP_CELL 
-view layout 
-point {0 0}

############################################################

# STEP 9

# Save COVER Cell

############################################################

puts ""
puts "================================"
puts "Save COVER Cell"
puts "================================"

lakerSaveDesign $COVER_CV

############################################################

# STEP 10

# Export GDS

############################################################

puts ""
puts "================================"
puts "Export GDS"
puts "Output : $OUTPUT_GDS"
puts "================================"

lakerExportStream 
-file $OUTPUT_GDS 
-lib $COVER_LIB 
-topCell $COVER_TOP_CELL 
-mergeRefLib 
-case Preserve 
-label Preserve 
-maxVerti 1024 
-logicProp 
-mcellProp 
-SmashMCell false 
-IoLayerMapMode true

############################################################

# Finish

############################################################

puts ""
puts "================================"
puts "GDS MERGE COMPLETE"
puts "Output : $OUTPUT_GDS"
puts "================================"

exit
