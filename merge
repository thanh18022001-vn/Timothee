############################################################

# merge.tcl

#

# Usage:

# laker -b merge.tcl input.cfg

#

# Flow:

# 1. Collect Macro GDS

# 2. Import Macro GDS

# 3. Import APR

# 4. Import APR_FILL

# 5. Import COVER

# 6. Open COVER cell

# 7. Create APR instance

# 8. Create APR_FILL instance

# 9. Save COVER cell

# 10. Export merged GDS

############################################################

############################################################

# Check Input

############################################################

if {$argc != 1} {

```
puts "Usage:"
puts "    laker -b merge.tcl input.cfg"
exit 1
```

}

set CFG_FILE [lindex $argv 0]

if {![file exists $CFG_FILE]} {

```
puts "ERROR: Config file not found"
puts $CFG_FILE
exit 1
```

}

############################################################

# Load Config

############################################################

source $CFG_FILE

############################################################

# Utility

############################################################

proc getLibName {filePath} {

```
set fileName [file tail $filePath]

regsub {\.gz$} $fileName "" fileName

foreach ext {.gds .oas .oasis} {

    if {[string match "*$ext" $fileName]} {

        regsub "$ext$" $fileName "" fileName
        break
    }
}

return $fileName
```

}

proc collectGDS {dir} {

```
set result {}

foreach file [glob -nocomplain -directory $dir *] {

    if {![file isfile $file]} {
        continue
    }

    set name [string tolower $file]

    if {
        [string match "*.gds"      $name] ||
        [string match "*.gds.gz"   $name] ||
        [string match "*.oas"      $name] ||
        [string match "*.oas.gz"   $name] ||
        [string match "*.oasis"    $name] ||
        [string match "*.oasis.gz" $name]
    } {
        lappend result $file
    }
}

return [lsort $result]
```

}

proc importStream {gdsFile libName {refLibList ""}} {

```
global TECH_FILE
global LAYER_MAP

puts ""
puts "================================"
puts "Import File : $gdsFile"
puts "Library     : $libName"
puts "RefLib      : $refLibList"
puts "================================"

if {$refLibList eq ""} {

    lakerImportStream \
        -file $gdsFile \
        -tech $TECH_FILE \
        -lib $libName \
        -IoLayerMapMode true \
        -case Preserve \
        -label Preserve \
        -maxVerti 1024 \
        -logicProp \
        -mcellProp \
        -layerMap $LAYER_MAP

} else {

    lakerImportStream \
        -file $gdsFile \
        -tech $TECH_FILE \
        -lib $libName \
        -reflib $refLibList \
        -IoLayerMapMode true \
        -case Preserve \
        -label Preserve \
        -maxVerti 1024 \
        -logicProp \
        -mcellProp \
        -layerMap $LAYER_MAP
}
```

}

############################################################

# STEP 1

# Collect Macro GDS

############################################################

set MACRO_LIST [collectGDS $MACRO_GDS_PATH]

if {[llength $MACRO_LIST] == 0} {

```
puts "ERROR: No Macro GDS Found"
puts $MACRO_GDS_PATH
exit 1
```

}

############################################################

# STEP 2

# Import Macro Libraries

############################################################

set MACRO_LIB_LIST {}

foreach macro $MACRO_LIST {

```
set macroLib [getLibName $macro]

lappend MACRO_LIB_LIST $macroLib

importStream \
    $macro \
    $macroLib
```

}

############################################################

# STEP 3

# Import APR

############################################################

set APR_LIB [getLibName $APR_GDS]

importStream 
$APR_GDS 
$APR_LIB 
$MACRO_LIB_LIST

############################################################

# STEP 4

# Import APR_FILL

############################################################

set APR_FILL_LIB [getLibName $APR_FILL_GDS]

importStream 
$APR_FILL_GDS 
$APR_FILL_LIB

############################################################

# STEP 5

# Import COVER

############################################################

set COVER_LIB [getLibName $COVER_GDS]

set COVER_REFLIBS [list 
$APR_LIB 
$APR_FILL_LIB]

importStream 
$COVER_GDS 
$COVER_LIB 
$COVER_REFLIBS

############################################################

# STEP 6

# Open COVER Cell

############################################################

set COVER_CV [lakerOpenDesign 
-lib $COVER_LIB 
-cell $COVER_TOP_CELL 
-view layout 
-mode edit]

############################################################

# STEP 7

# Create APR Instance

############################################################

lakerCreateInstance 
-cellView $COVER_CV 
-lib $APR_LIB 
-cell $APR_TOP_CELL 
-view layout 
-point {0 0}

############################################################

# STEP 8

# Create APR_FILL Instance

############################################################

lakerCreateInstance 
-cellView $COVER_CV 
-lib $APR_FILL_LIB 
-cell $APR_FILL_TOP_CELL 
-view layout 
-point {0 0}

############################################################

# STEP 9

# Save Design

############################################################

lakerSaveDesign $COVER_CV

############################################################

# STEP 10

# Export GDS

############################################################

lakerExportStream 
-file $OUTPUT_GDS 
-lib $COVER_LIB 
-topCell $COVER_TOP_CELL 
-mergeRefLib 
-case Preserve 
-label Preserve 
-maxVerti 1024 
-logicProp 
-mcellProp 
-SmashMCell false 
-IoLayerMapMode true

puts ""
puts "GDS MERGE COMPLETE"
puts $OUTPUT_GDS

exit
